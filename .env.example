# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings -> API Keys). Use apenas a chave publishable/anon, nunca a secret.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Somente para o script "npm run seed:demo" (contas de demonstração) ---
# A chave secret/service_role NUNCA vai no app nem no Vercel. Use só no seu computador.
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_PASSWORD=
